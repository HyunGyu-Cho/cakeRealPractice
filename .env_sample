# Copy this file to .env and enter values for your environment.
# Never commit the completed .env file.

# MariaDB installed directly on each developer's PC.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3307
LOCAL_DB_DATABASE=cakeshop
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=test1234

# Shared AWS RDS connection.
RDS_ENDPOINT=your-rds-endpoint
RDS_PORT=3306
RDS_DATABASE=your-rds-database
RDS_USERNAME=your-rds-username
RDS_PASSWORD=your-rds-password

# Local directory (outside the project): where uploaded images are stored.
# If unset, defaults to <user home>/cakeshop-uploads.
FILE_UPLOAD_DIR=C:/cakeshop-uploads

# Private chat images. This directory is never exposed through /uploads/**.
# If unset, defaults to <user home>/cakeshop-chat-images.
CHAT_IMAGE_DIR=C:/cakeshop-chat-images

# Payment provider: mock (no external call, the default) or toss (real approval).
# Leave as mock unless you have Toss test keys.
PAYMENT_PROVIDER=mock

# Toss Payments test keys. Required only when PAYMENT_PROVIDER=toss.
# The client key is exposed in the page; the secret key must never leave the server.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
