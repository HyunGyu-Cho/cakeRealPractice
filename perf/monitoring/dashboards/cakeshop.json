{
  "uid": "cakeshop-overview",
  "title": "cakeshop — 앱 성능 개요",
  "description": "화면별 응답시간·처리량과 커넥션풀·힙. 커뮤니티 성능 작업(V4 인덱스 + 쿼리 리라이트)의 효과를 앱 계층에서 확인하는 용도.",
  "tags": ["cakeshop", "spring-boot"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "처리량",
      "description": "초당 완료한 HTTP 요청 수. 부하 측정 중 이 값이 천장을 치면 포화 상태다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"cakeshop\"}[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 응답시간",
      "description": "전체 요청의 95번째 백분위. 평균이 아니라 이걸 본다 — 평균은 롱테일을 숨긴다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"cakeshop\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 0.2 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "서버 에러율 (5xx)",
      "description": "전체 요청 대비 5xx 비율. 좋아요 토글 동시성 오류가 500으로 새면 여기서 보인다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"cakeshop\",outcome=\"SERVER_ERROR\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"cakeshop\"}[1m])), 0.0001)",
          "legendFormat": "5xx"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB 커넥션 대기",
      "description": "커넥션을 얻으려고 기다리는 스레드 수. 0이 아니면 풀(기본 10개)이 부족하거나 쿼리가 느린 것이다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_pending{application=\"cakeshop\"})",
          "legendFormat": "대기"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "화면별 p95 응답시간",
      "description": "URI별 95백분위. 커뮤니티 목록·메인이 다른 화면 위로 솟으면 그게 병목이다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"cakeshop\",uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "p95 (초)"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "화면별 처리량",
      "description": "URI별 초당 요청 수. 위 패널과 함께 보면 '느린데 많이 불리는' 화면이 드러난다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"cakeshop\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "req/s"
          }
        },
        "overrides": []
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "DB 커넥션풀 (HikariCP)",
      "description": "사용중 + 유휴 = 풀 크기(기본 10). 대기가 0보다 크면 풀이 병목이다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"cakeshop\"})",
          "legendFormat": "사용중"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{application=\"cakeshop\"})",
          "legendFormat": "유휴"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{application=\"cakeshop\"})",
          "legendFormat": "대기"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "커넥션 수"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "사용중" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "유휴" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          },
          {
            "matcher": { "id": "byName", "options": "대기" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM 힙 사용량",
      "description": "톱니 모양이 정상(GC가 주기적으로 회수). 회수 후에도 바닥이 계속 올라가면 누수를 의심한다.",
      "datasource": { "type": "prometheus", "uid": "cakeshop-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"cakeshop\",area=\"heap\"})",
          "legendFormat": "사용중"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{application=\"cakeshop\",area=\"heap\"})",
          "legendFormat": "확보됨"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "바이트"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "사용중" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "확보됨" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      }
    }
  ]
}
