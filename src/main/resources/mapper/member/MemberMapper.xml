<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cakeshop.domain.member.mapper.MemberMapper">
    <resultMap id="memberResultMap" type="com.cakeshop.domain.member.entity.Member">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="suspendedAt" column="suspended_at"/>
        <result property="suspendedReason" column="suspended_reason"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="withdrawnAt" column="withdrawn_at"/>
    </resultMap>

    <!-- 인증 입력도 문자열 치환 없이 #{}로 바인딩한다.
         status를 함께 내려 MemberDetailsService가 정지·탈퇴 계정을 판정한다(스펙 docs/specs/member.md). -->
    <select id="findByEmail" resultMap="memberResultMap">
        SELECT id, email, password, nickname, role, status, created_at
          FROM members
         WHERE email = #{email}
    </select>

    <!-- 제재 컬럼 3개는 관리자 상세가 사용한다(고객 화면은 읽지 않는다). -->
    <select id="findById" resultMap="memberResultMap">
        SELECT id, email, password, nickname, phone, role, status, created_at, updated_at,
               suspended_at, suspended_reason, withdrawn_at
          FROM members
         WHERE id = #{id}
    </select>

    <select id="countByEmail" resultType="int">
        SELECT COUNT(*)
          FROM members
         WHERE email = #{email}
    </select>

    <!-- role·status·created_at은 DDL DEFAULT(USER/ACTIVE/CURRENT_TIMESTAMP)에 위임한다. -->
    <insert id="insertMember" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO members (email, password, nickname, phone)
        VALUES (#{email}, #{password}, #{nickname}, #{phone})
    </insert>

    <!-- updated_at은 DDL의 ON UPDATE CURRENT_TIMESTAMP(6)에 위임한다. -->
    <update id="updateProfile">
        UPDATE members
           SET nickname = #{nickname},
               phone = #{phone}
         WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE members
           SET password = #{password}
         WHERE id = #{id}
    </update>

    <!-- withdrawn_at은 업무 시각이라 SQL에서 세팅한다(created/updated_at 위임 규칙과 별개). -->
    <update id="withdraw">
        UPDATE members
           SET status = 'WITHDRAWN',
               withdrawn_at = CURRENT_TIMESTAMP(6)
         WHERE id = #{id}
           AND status = 'ACTIVE'
    </update>

    <!-- 타 도메인 표시용 배치 조회. 필요한 컬럼(id·nickname)만 내려 회원 정보 노출을 최소화한다. -->
    <select id="findNicknamesByIds" resultMap="memberResultMap">
        SELECT id, nickname
          FROM members
         WHERE id IN
        <foreach collection="ids" item="memberId" open="(" separator="," close=")">
            #{memberId}
        </foreach>
    </select>

    <select id="findProfilesByIds" resultMap="memberResultMap">
        SELECT id, nickname, email, created_at
          FROM members
         WHERE id IN
        <foreach collection="ids" item="memberId" open="(" separator="," close=")">
            #{memberId}
        </foreach>
    </select>

    <!-- 관리자 화면의 작성자 검색용 닉네임 부분 일치 조회 -->
    <select id="findIdsByNicknameLike" resultType="long">
        SELECT id
          FROM members
         WHERE nickname LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 알림 팬아웃 대상. 정지·탈퇴 계정은 제외한다. -->
    <select id="findActiveAdminIds" resultType="long">
        SELECT id
          FROM members
         WHERE role = 'ADMIN'
           AND status = 'ACTIVE'
         ORDER BY id
    </select>

    <select id="findIdsByKeyword" resultType="long">
        SELECT id
          FROM members
         WHERE nickname LIKE CONCAT('%', #{keyword}, '%')
            OR email LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 통계용 신규 가입 수. 탈퇴자도 가입 시점의 실적이므로 status로 걸러내지 않고,
         관리자 계정만 제외한다. -->
    <select id="countCreatedBetween" resultType="long">
        SELECT COUNT(*)
          FROM members
         WHERE role = 'USER'
           AND created_at &gt;= #{from}
           AND created_at &lt; #{to}
    </select>

    <!-- ==================== 관리자 회원 관리 ==================== -->

    <!-- 검색 조건은 form이 trim·enum 검증을 끝낸 정규화 값만 쓴다. LIKE 값도 #{}로 바인딩한다. -->
    <sql id="adminSearchWhere">
        <where>
            <if test="cond.normalizedName != null">
                AND nickname LIKE CONCAT('%', #{cond.normalizedName}, '%')
            </if>
            <if test="cond.normalizedEmail != null">
                AND email LIKE CONCAT('%', #{cond.normalizedEmail}, '%')
            </if>
            <if test="cond.normalizedStatus != null">
                AND status = #{cond.normalizedStatus}
            </if>
        </where>
    </sql>

    <select id="countAdminMembers" resultType="long">
        SELECT COUNT(*)
          FROM members
        <include refid="adminSearchWhere"/>
    </select>

    <select id="findAdminMemberPage" resultMap="memberResultMap">
        SELECT id, email, nickname, phone, role, status, created_at,
               suspended_at, suspended_reason, withdrawn_at
          FROM members
        <include refid="adminSearchWhere"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 현재 상태를 조건에 걸어 동시 요청이 겹쳐도 한 번만 반영되게 한다. -->
    <update id="suspend">
        UPDATE members
           SET status = 'SUSPENDED',
               suspended_at = CURRENT_TIMESTAMP(6),
               suspended_reason = #{reason}
         WHERE id = #{id}
           AND status = 'ACTIVE'
    </update>

    <update id="unsuspend">
        UPDATE members
           SET status = 'ACTIVE',
               suspended_at = NULL,
               suspended_reason = NULL
         WHERE id = #{id}
           AND status = 'SUSPENDED'
    </update>
</mapper>
